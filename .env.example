# ────────────────────────────────────────────────────────────────────────────
# Скопируйте этот файл в .env и заполните значениями.
# Copy this file to .env and fill in your values.
# ────────────────────────────────────────────────────────────────────────────

# --- Блокчейн ---------------------------------------------------------------

# Приватный ключ владельца контракта (owner) для подписи транзакций бэка.
# Для локального hardhat — первый аккаунт (см. вывод `npx hardhat node`).
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# URL RPC-узла. Локальный hardhat по умолчанию слушает на 127.0.0.1:8545.
RPC_URL=http://127.0.0.1:8545

# Адрес развёрнутого контракта VoteChain.
# При чистом деплое скриптом scripts/deploy.js на свежем hardhat node
# адрес всегда будет одинаковым — 0x5FbDB2315678afecb367f032d93F642f64180aa3
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# --- Django -----------------------------------------------------------------

# Секретный ключ Django. Для учебного проекта можно оставить дефолт.
# Для прода обязательно сгенерировать новый!
# DJANGO_SECRET_KEY=django-insecure-uhao!!xy6-&s25qm-dy%=c44s(ro!8!x=rl0xp67+bcmjfbet=

# Режим отладки. True для разработки, False для прода.
# DJANGO_DEBUG=True

# Разрешённые хосты (через запятую). * — для разработки.
# DJANGO_ALLOWED_HOSTS=*

# --- CORS -------------------------------------------------------------------

# Разрешать запросы со всех источников. Удобно для разработки фронта.
# CORS_ALLOW_ALL=True
