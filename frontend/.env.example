# ─── Адреса бэкенда и блокчейна ─────────────────────────────────────────────
# В dev-режиме Vite проксирует /api на этот адрес.
# В Docker значение можно не задавать — будет использован относительный путь.
VITE_API_PROXY_TARGET=http://localhost:8000

# Адрес RPC-узла блокчейна (для MetaMask и прямых вызовов контракта).
# Для локального hardhat:
VITE_RPC_URL=http://127.0.0.1:8545

# ChainId сети (31337 — локальный hardhat, 80002 — Polygon Amoy).
VITE_CHAIN_ID=31337

# Адрес развёрнутого контракта VoteChain.
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# WalletConnect Project ID (опционально, нужен для подключения мобильных кошельков).
# Получить можно бесплатно на https://cloud.walletconnect.com
# Можно оставить пустым — MetaMask и Coinbase Wallet и так будут работать.
VITE_WALLETCONNECT_PROJECT_ID=
