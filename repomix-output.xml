<file path="api/views.py">
"""
views.py — основные обработчики (views) REST API для VoteChain.

Каждый класс-view отвечает за один или несколько эндпоинтов.
Все операции с блокчейном выполняются синхронно (без async/await).

Эндпоинты:
  POST   /api/elections/                          — создать голосование
  GET    /api/elections/<id>/                     — получить данные голосования
  POST   /api/elections/<id>/whitelist/           — добавить адрес в белый список
  POST   /api/elections/<id>/close/               — закрыть голосование
  GET    /api/elections/<id>/results/             — результаты голосования
  GET    /api/elections/<id>/voters/<address>/status/ — статус избирателя
"""

from rest_framework.views import APIView
from rest_framework.response import Response
from rest_framework import status

from web3 import Web3
from web3.exceptions import ContractLogicError

# Импортируем наш модуль для работы с блокчейном
from .blockchain import contract, w3, send_transaction


# ─────────────────────────────────────────────────────────────────────────────
# Вспомогательная функция для обработки ошибок контракта
# ─────────────────────────────────────────────────────────────────────────────

def extract_revert_reason(exc):
    """
    Извлекает читаемое сообщение об ошибке из исключения ContractLogicError.
    Контракт Solidity возвращает строку через require(..., "сообщение").
    """
    msg = str(exc)
    # Ищем текст после "execution reverted:"
    if "execution reverted:" in msg:
        return msg.split("execution reverted:")[-1].strip()
    if "revert" in msg.lower():
        return msg
    return "Ошибка выполнения транзакции"


# ─────────────────────────────────────────────────────────────────────────────
# POST /api/elections/  — создать новое голосование
# GET  /api/elections/  — (не используется, но можно добавить список)
# ─────────────────────────────────────────────────────────────────────────────

class ElectionListView(APIView):
    """
    POST /api/elections/
    
    Тело запроса (JSON):
    {
        "title": "Название голосования",
        "candidates": ["Кандидат 1", "Кандидат 2", "Кандидат 3"]
    }
    
    Ответ (201 Created):
    {
        "election_id": 1,
        "message": "Голосование успешно создано",
        "tx_hash": "0x..."
    }
    """

    def post(self, request):
        # Получаем данные из тела запроса
        title = request.data.get("title")
        candidates = request.data.get("candidates")

        # Проверяем, что все поля переданы
        if not title:
            return Response(
                {"error": "Поле 'title' обязательно"},
                status=status.HTTP_400_BAD_REQUEST
            )
        if not candidates or not isinstance(candidates, list):
            return Response(
                {"error": "Поле 'candidates' обязательно и должно быть списком"},
                status=status.HTTP_400_BAD_REQUEST
            )
        if len(candidates) < 2:
            return Response(
                {"error": "Нужно минимум 2 кандидата"},
                status=status.HTTP_400_BAD_REQUEST
            )

        try:
            # Вызываем функцию контракта createElection(title, candidates)
            # send_transaction подпишет и отправит транзакцию от имени owner
            receipt = send_transaction(
                contract.functions.createElection(title, candidates)
            )

            # После создания голосования получаем его ID:
            # electionCount() возвращает общее количество голосований,
            # а новое голосование имеет ID = electionCount - 1
            election_count = contract.functions.electionCount().call()
            new_election_id = election_count - 1

            return Response(
                {
                    "election_id": new_election_id,
                    "message": "Голосование успешно создано",
                    "tx_hash": receipt["transactionHash"].hex(),
                },
                status=status.HTTP_201_CREATED
            )

        except ContractLogicError as e:
            # Ошибка из контракта (например, "At least two candidates required")
            return Response(
                {"error": extract_revert_reason(e)},
                status=status.HTTP_400_BAD_REQUEST
            )
        except Exception as e:
            # Любая другая ошибка (нет соединения, недостаток газа и т.д.)
            return Response(
                {"error": f"Ошибка при создании голосования: {str(e)}"},
                status=status.HTTP_500_INTERNAL_SERVER_ERROR
            )


# ─────────────────────────────────────────────────────────────────────────────
# GET /api/elections/<id>/  — получить данные о голосовании
# ─────────────────────────────────────────────────────────────────────────────

class ElectionDetailView(APIView):
    """
    GET /api/elections/<id>/
    
    Ответ (200 OK):
    {
        "election_id": 0,
        "title": "Название голосования",
        "is_open": true,
        "total_votes": 5
    }
    """

    def get(self, request, election_id):
        try:
            # Вызываем getElection(electionId) — это view-функция, не транзакция
            # .call() выполняет чтение без отправки транзакции (бесплатно)
            title, is_open, total_votes = contract.functions.getElection(election_id).call()

            return Response({
                "election_id": election_id,
                "title": title,
                "is_open": is_open,
                "total_votes": total_votes,
            })

        except ContractLogicError as e:
            reason = extract_revert_reason(e)
            # Если голосование не существует — возвращаем 404
            if "does not exist" in reason.lower():
                return Response({"error": reason}, status=status.HTTP_404_NOT_FOUND)
            return Response({"error": reason}, status=status.HTTP_400_BAD_REQUEST)
        except Exception as e:
            return Response(
                {"error": f"Ошибка при получении данных: {str(e)}"},
                status=status.HTTP_500_INTERNAL_SERVER_ERROR
            )


# ─────────────────────────────────────────────────────────────────────────────
# POST /api/elections/<id>/whitelist/  — добавить адрес в белый список
# ─────────────────────────────────────────────────────────────────────────────

class WhitelistView(APIView):
    """
    POST /api/elections/<id>/whitelist/
    
    Тело запроса (JSON):
    {
        "userAddress": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8"
    }
    
    Ответ (200 OK):
    {
        "message": "Адрес успешно добавлен в белый список",
        "tx_hash": "0x..."
    }
    """

    def post(self, request, election_id):
        user_address = request.data.get("userAddress")

        if not user_address:
            return Response(
                {"error": "Поле 'userAddress' обязательно"},
                status=status.HTTP_400_BAD_REQUEST
            )

        # Проверяем, что адрес имеет правильный формат Ethereum
        if not Web3.is_address(user_address):
            return Response(
                {"error": f"Некорректный Ethereum-адрес: {user_address}"},
                status=status.HTTP_400_BAD_REQUEST
            )

        try:
            # Конвертируем адрес в checksum-формат (стандарт EIP-55)
            checksum_address = Web3.to_checksum_address(user_address)

            # Вызываем addToWhitelist(electionId, userAddress)
            receipt = send_transaction(
                contract.functions.addToWhitelist(election_id, checksum_address)
            )

            return Response({
                "message": f"Адрес {checksum_address} успешно добавлен в белый список",
                "tx_hash": receipt["transactionHash"].hex(),
            })

        except ContractLogicError as e:
            reason = extract_revert_reason(e)
            if "does not exist" in reason.lower():
                return Response({"error": reason}, status=status.HTTP_404_NOT_FOUND)
            return Response({"error": reason}, status=status.HTTP_400_BAD_REQUEST)
        except Exception as e:
            return Response(
                {"error": f"Ошибка при добавлении в белый список: {str(e)}"},
                status=status.HTTP_500_INTERNAL_SERVER_ERROR
            )


# ─────────────────────────────────────────────────────────────────────────────
# POST /api/elections/<id>/close/  — закрыть голосование
# ─────────────────────────────────────────────────────────────────────────────

class CloseElectionView(APIView):
    """
    POST /api/elections/<id>/close/
    
    Тело запроса: пустое (не нужно ничего передавать)
    
    Ответ (200 OK):
    {
        "message": "Голосование 0 успешно закрыто",
        "tx_hash": "0x..."
    }
    """

    def post(self, request, election_id):
        try:
            # Вызываем closeElection(electionId)
            receipt = send_transaction(
                contract.functions.closeElection(election_id)
            )

            return Response({
                "message": f"Голосование {election_id} успешно закрыто",
                "tx_hash": receipt["transactionHash"].hex(),
            })

        except ContractLogicError as e:
            reason = extract_revert_reason(e)
            if "does not exist" in reason.lower():
                return Response({"error": reason}, status=status.HTTP_404_NOT_FOUND)
            return Response({"error": reason}, status=status.HTTP_400_BAD_REQUEST)
        except Exception as e:
            return Response(
                {"error": f"Ошибка при закрытии голосования: {str(e)}"},
                status=status.HTTP_500_INTERNAL_SERVER_ERROR
            )


# ─────────────────────────────────────────────────────────────────────────────
# GET /api/elections/<id>/results/  — результаты голосования
# ─────────────────────────────────────────────────────────────────────────────

class ElectionResultsView(APIView):
    """
    GET /api/elections/<id>/results/
    
    Ответ (200 OK):
    {
        "election_id": 0,
        "results": [
            {"candidate": "Кандидат А", "votes": 3},
            {"candidate": "Кандидат Б", "votes": 1}
        ]
    }
    """

    def get(self, request, election_id):
        try:
            # Вызываем getResults(electionId) — возвращает два массива:
            # candidates (список имён) и votes (список количества голосов)
            candidates, votes = contract.functions.getResults(election_id).call()

            # Объединяем два массива в список словарей для удобного JSON
            results = [
                {"candidate": candidate, "votes": vote_count}
                for candidate, vote_count in zip(candidates, votes)
            ]

            return Response({
                "election_id": election_id,
                "results": results,
            })

        except ContractLogicError as e:
            reason = extract_revert_reason(e)
            if "does not exist" in reason.lower():
                return Response({"error": reason}, status=status.HTTP_404_NOT_FOUND)
            return Response({"error": reason}, status=status.HTTP_400_BAD_REQUEST)
        except Exception as e:
            return Response(
                {"error": f"Ошибка при получении результатов: {str(e)}"},
                status=status.HTTP_500_INTERNAL_SERVER_ERROR
            )


# ─────────────────────────────────────────────────────────────────────────────
# GET /api/elections/<id>/voters/<address>/status/  — статус избирателя
# ─────────────────────────────────────────────────────────────────────────────

class VoterStatusView(APIView):
    """
    GET /api/elections/<id>/voters/<address>/status/
    
    Ответ (200 OK):
    {
        "election_id": 0,
        "address": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
        "whitelisted": true,
        "has_voted": false,
        "can_vote": true
    }
    """

    def get(self, request, election_id, address):
        # Проверяем корректность адреса
        if not Web3.is_address(address):
            return Response(
                {"error": f"Некорректный Ethereum-адрес: {address}"},
                status=status.HTTP_400_BAD_REQUEST
            )

        try:
            checksum_address = Web3.to_checksum_address(address)

            # Проверяем, есть ли адрес в белом списке
            # whitelist(electionId, address) — публичный маппинг в контракте
            is_whitelisted = contract.functions.whitelist(election_id, checksum_address).call()

            # Проверяем, голосовал ли уже этот адрес
            # hasVoted(electionId, address) — публичный маппинг в контракте
            has_voted = contract.functions.hasVoted(election_id, checksum_address).call()

            # Может голосовать = в белом списке И ещё не голосовал
            can_vote = is_whitelisted and not has_voted

            return Response({
                "election_id": election_id,
                "address": checksum_address,
                "whitelisted": is_whitelisted,
                "has_voted": has_voted,
                "can_vote": can_vote,
            })

        except ContractLogicError as e:
            reason = extract_revert_reason(e)
            if "does not exist" in reason.lower():
                return Response({"error": reason}, status=status.HTTP_404_NOT_FOUND)
            return Response({"error": reason}, status=status.HTTP_400_BAD_REQUEST)
        except Exception as e:
            return Response(
                {"error": f"Ошибка при проверке статуса: {str(e)}"},
                status=status.HTTP_500_INTERNAL_SERVER_ERROR
            )
